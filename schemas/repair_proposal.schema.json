{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Dependency Repair Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "install_name", "version", "rationale"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["install", "pin_version", "none"]
    },
    "install_name": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "version": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "install" } } },
      "then": {
        "properties": {
          "install_name": { "type": "string", "minLength": 1 },
          "version": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "pin_version" } } },
      "then": {
        "properties": {
          "install_name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "none" } } },
      "then": {
        "properties": {
          "install_name": { "type": "null" },
          "version": { "type": "null" }
        }
      }
    }
  ]
}
