@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix map: <http://mapping.example.com/> .
@prefix ma: <http://www.w3.org/ns/ma-ont#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov-o#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix v: <http://rdf.data-vocabulary.org/#> .
@prefix schema: <http://schema.org/> .
@prefix repr: <https://w3id.org/reproduceme/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix pav: <http://purl.org/pav/> .
@prefix p-plan: <http://purl.org/net/p-plan> .
@prefix pext: <http://www.ontotext.com/proton/protonext#> .
@prefix mesh: <http://purl.bioontology.org/ontology/MESH/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

# --- the repair attempt itself -----------------------------------------------

map:map_repair_attempts_000 rml:logicalSource map:source_000 ;
	rdf:type rr:TriplesMap ;
	rdfs:label "repair_attempts" ;
	rr:predicateObjectMap map:pom_000, map:pom_001, map:pom_002, map:pom_003, map:pom_004, map:pom_005, map:pom_006, map:pom_007, map:pom_008, map:pom_009, map:pom_010, map:pom_011, map:pom_012, map:pom_013, map:pom_014, map:pom_015, map:pom_016, map:pom_017, map:pom_018 ;
	rr:subjectMap map:s_000 .

map:s_000 rdf:type rr:SubjectMap ;
	rr:template "https://w3id.org/reproduceme/repairattempt_{id}" .

map:source_000 rml:referenceFormulation ql:CSV ;
	rml:source "data/repair_attempts.csv" ;
	rdf:type rml:LogicalSource .

map:om_000 rdf:type rr:ObjectMap ;
	rr:constant repr:RepairAttempt ;
	rr:termType rr:IRI .

map:om_001 rdf:type rr:ObjectMap ;
	rr:constant prov:Activity ;
	rr:termType rr:IRI .

map:om_002 rml:reference "failing_module" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_003 rml:reference "subtype" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_004 rml:reference "explanation" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_005 rml:reference "action" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_006 rml:reference "install_name" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_007 rml:reference "version" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_008 rml:reference "command" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_009 rml:reference "rationale" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_010 rml:reference "pypi_evidence" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_011 rml:reference "outcome" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

# repr:exception / repr:msg reused from executions.rml.ttl for the
# post-repair error, rather than minting new predicates for it - it is the
# same kind of fact (an exception type + message) as a CellExecution's own
# exception/msg, just observed after the fix was applied.
map:om_012 rml:reference "new_error_type" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_013 rml:reference "new_error_message" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_014 rml:reference "llm_model" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_015 rml:reference "prompt_strategy" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_016 rml:reference "round" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_017 rml:reference "run_id" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

# created_at -> prov:endedAtTime is explicitly typed xsd:dateTime (unlike
# this KG's other literal object maps, which leave the datatype unset) -
# PROV-O's own spec gives prov:endedAtTime range xsd:dateTime, and our
# created_at values are already ISO-8601 strings.
map:om_018 rml:reference "created_at" ;
	rdf:type rr:ObjectMap ;
	rr:datatype xsd:dateTime ;
	rr:termType rr:Literal .

map:pm_000 rdf:type rr:PredicateMap ;
	rr:constant rdf:type .

map:pm_001 rdf:type rr:PredicateMap ;
	rr:constant rdf:type .

map:pm_002 rdf:type rr:PredicateMap ;
	rr:constant repr:failingModule .

map:pm_003 rdf:type rr:PredicateMap ;
	rr:constant repr:subtype .

map:pm_004 rdf:type rr:PredicateMap ;
	rr:constant repr:explanation .

map:pm_005 rdf:type rr:PredicateMap ;
	rr:constant repr:fixAction .

map:pm_006 rdf:type rr:PredicateMap ;
	rr:constant repr:installName .

map:pm_007 rdf:type rr:PredicateMap ;
	rr:constant repr:fixVersion .

map:pm_008 rdf:type rr:PredicateMap ;
	rr:constant repr:fixCommand .

map:pm_009 rdf:type rr:PredicateMap ;
	rr:constant repr:fixRationale .

map:pm_010 rdf:type rr:PredicateMap ;
	rr:constant repr:pypiEvidence .

map:pm_011 rdf:type rr:PredicateMap ;
	rr:constant repr:fixOutcome .

map:pm_012 rdf:type rr:PredicateMap ;
	rr:constant repr:exception .

map:pm_013 rdf:type rr:PredicateMap ;
	rr:constant repr:msg .

map:pm_014 rdf:type rr:PredicateMap ;
	rr:constant repr:llmModel .

map:pm_015 rdf:type rr:PredicateMap ;
	rr:constant repr:promptStrategy .

map:pm_016 rdf:type rr:PredicateMap ;
	rr:constant repr:round .

map:pm_017 rdf:type rr:PredicateMap ;
	rr:constant repr:runId .

map:pm_018 rdf:type rr:PredicateMap ;
	rr:constant prov:endedAtTime .

map:pom_000 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_000 ;
	rr:predicateMap map:pm_000 .

map:pom_001 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_001 ;
	rr:predicateMap map:pm_001 .

map:pom_002 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_002 ;
	rr:predicateMap map:pm_002 .

map:pom_003 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_003 ;
	rr:predicateMap map:pm_003 .

map:pom_004 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_004 ;
	rr:predicateMap map:pm_004 .

map:pom_005 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_005 ;
	rr:predicateMap map:pm_005 .

map:pom_006 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_006 ;
	rr:predicateMap map:pm_006 .

map:pom_007 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_007 ;
	rr:predicateMap map:pm_007 .

map:pom_008 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_008 ;
	rr:predicateMap map:pm_008 .

map:pom_009 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_009 ;
	rr:predicateMap map:pm_009 .

map:pom_010 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_010 ;
	rr:predicateMap map:pm_010 .

map:pom_011 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_011 ;
	rr:predicateMap map:pm_011 .

map:pom_012 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_012 ;
	rr:predicateMap map:pm_012 .

map:pom_013 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_013 ;
	rr:predicateMap map:pm_013 .

map:pom_014 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_014 ;
	rr:predicateMap map:pm_014 .

map:pom_015 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_015 ;
	rr:predicateMap map:pm_015 .

map:pom_016 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_016 ;
	rr:predicateMap map:pm_016 .

map:pom_017 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_017 ;
	rr:predicateMap map:pm_017 .

map:pom_018 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_018 ;
	rr:predicateMap map:pm_018 .

# --- the link from the existing notebook to this repair attempt -------------
#
# Same CSV, a second independent TriplesMap: its subject template
# (notebook_{notebook_id}) is byte-for-byte the same shape as
# notebooks.rml.ttl's own subject template (notebook_{id}), so the two
# coincide as the same node once loaded into the same graph - no join and
# no edit to notebooks.rml.ttl required. notebook_id is resolved into the
# CSV by scripts/export_repair_attempts_csv.py (see that file for why
# repair_attempts itself only stores notebook_execution_id).

map:map_notebook_repair_link_000 rml:logicalSource map:source_000 ;
	rdf:type rr:TriplesMap ;
	rdfs:label "notebook_repair_link" ;
	rr:predicateObjectMap map:pom_019 ;
	rr:subjectMap map:s_001 .

map:s_001 rdf:type rr:SubjectMap ;
	rr:template "https://w3id.org/reproduceme/notebook_{notebook_id}" .

map:om_019 rdf:type rr:ObjectMap ;
	rr:template "https://w3id.org/reproduceme/repairattempt_{id}" ;
	rr:termType rr:IRI .

map:pm_019 rdf:type rr:PredicateMap ;
	rr:constant repr:hadRepairAttempt .

map:pom_019 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_019 ;
	rr:predicateMap map:pm_019 .

map:rules_000 <http://rdfs.org/ns/void#exampleResource> map:map_repair_attempts_000, map:map_notebook_repair_link_000 ;
	rdf:type <http://rdfs.org/ns/void#Dataset> .
